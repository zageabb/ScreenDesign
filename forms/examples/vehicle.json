{
  "slug": "vehicle",
  "title": "Vehicle",
  "version": 4,
  "mode": "list",
  "ui": {
    "layout": "table",
    "tableLayout": {
      "columns": 2,
      "rows": [
        ["reg", "manufacturer"],
        ["mileage", "notes"]
      ]
    }
  },
  "columns": [
    "reg",
    "manufacturer",
    "mileage",
    "notes"
  ],
  "fields": [
    {
      "name": "reg",
      "type": "text",
      "label": "Registration"
    },
    {
      "name": "manufacturer",
      "type": "text",
      "label": "Vehicle Manufacturer"
    },
    {
      "name": "mileage",
      "type": "number",
      "label": "Mileage",
      "default": 0
    },
    {
      "name": "notes",
      "type": "textarea",
      "label": "Notes",
      "ui": {
        "rows": 4,
        "colSpan": 2,
        "tableSpan": 2
      }
    },
    {
      "name": "parts",
      "type": "group",
      "mode": "repeatable-table",
      "label": "Parts Used",
      "fields": [
        {
          "name": "part",
          "type": "text",
          "label": "Part"
        },
        {
          "name": "qty",
          "type": "number",
          "label": "Qty",
          "default": 1
        },
        {
          "name": "cost",
          "type": "number",
          "label": "Cost",
          "default": 0
        },
        {
          "name": "line_total",
          "type": "number",
          "label": "Line Total",
          "compute": "qty * cost"
        }
      ],
      "default": []
    }
  ]
}